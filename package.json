{
  "name": "@cubux/effector-persistent",
  "version": "0.9.0",
  "description": "Persist data in effector store.",
  "keywords": [
    "effector",
    "store",
    "persist",
    "persistent",
    "localStorage",
    "sessionStorage",
    "indexedDB"
  ],
  "author": {
    "name": "Vovan-VE",
    "email": "vovan-ve@yandex.ru"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubux-net/effector-persistent.git"
  },
  "bugs": {
    "url": "https://github.com/cubux-net/effector-persistent/issues"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsup --watch src",
    "prepare": "npm run build",
    "test": "tsc --noEmit && vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "npm test -- --coverage"
  },
  "peerDependencies": {
    "@cubux/storage-driver": "^0.4 || ^0.5 || ^0.6",
    "effector": "^23",
    "typescript": "^4 || ^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "husky": "^8.0.1",
    "lint-staged": "^15.2.0",
    "prettier": "3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
